# Port aplikasi web
PORT=3000

# Secret session untuk enkripsi cookie session (ganti dengan string acak panjang di production)
SESSION_SECRET=ganti_dengan_random_secret_yang_panjang_dan_aman_minimal_32_karakter

# Path database SQLite (default: data/spk_sawit.db atau :memory: untuk pengujian cepat)
DB_PATH=data/spk_sawit.db
