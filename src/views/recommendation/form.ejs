<%- include('../layouts/header') %>

<div class="space-y-6">

  <!-- Header Breadcrumb & Info -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <nav class="flex text-xs text-slate-400 mb-1" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-600">Dashboard</a>
        <span class="mx-2">/</span>
        <span class="text-slate-600 font-medium">Analisis Rekomendasi</span>
      </nav>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Form Analisis Kondisi Bibit & Media</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        Isi parameter kondisi bibit dan media tanam untuk memperoleh rekomendasi jenis pupuk, waktu, dan tingkat dosis.
      </p>
    </div>

    <!-- Quick action demo -->
    <button type="button" onclick="randomizeSimulation()" class="inline-flex items-center px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs shadow-sm transition">
      <i class="fas fa-random mr-1.5"></i> Acak Simulasi Demo
    </button>
  </div>

  <!-- DEMO SIMULATION PRESET SECTION -->
  <div id="demo-section" class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-5 text-white shadow-md border border-slate-700">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 pb-3 border-b border-slate-700/80 mb-4">
      <div>
        <div class="inline-flex items-center space-x-1.5 text-xs font-semibold text-amber-400 uppercase tracking-wider mb-1">
          <i class="fas fa-magic"></i>
          <span>Fitur Demo & Uji Sidang SPK</span>
        </div>
        <h3 class="text-base font-bold text-white">Preset Skenario Uji Cepat</h3>
      </div>
      <p class="text-xs text-slate-300 max-w-md">
        Pilih salah satu skenario untuk otomatis mengisi form dengan kondisi bibit riil di nursery.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      
      <!-- Skenario 1 -->
      <button type="button" onclick="fillPreset('scenario1')" class="text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-palm-500 transition group">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-bold text-emerald-400 group-hover:text-emerald-300">Skenario 1: Pre-Nursery Sehat</span>
          <span class="text-[10px] bg-slate-700 px-1.5 py-0.5 rounded text-slate-300">1-3 Bulan</span>
        </div>
        <p class="text-[11px] text-slate-400 line-clamp-2">Daun normal, perakaran muda rentan. Menguji target POC lembut ramah akar.</p>
      </button>

      <!-- Skenario 2 -->
      <button type="button" onclick="fillPreset('scenario2')" class="text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-blue-500 transition group">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-bold text-blue-400 group-hover:text-blue-300">Skenario 2: Defisiensi Nitrogen (N)</span>
          <span class="text-[10px] bg-slate-700 px-1.5 py-0.5 rounded text-slate-300">Main Awal</span>
        </div>
        <p class="text-[11px] text-slate-400 line-clamp-2">Daun menguning merata. Menguji dominasi Urea & NPK majemuk.</p>
      </button>

      <!-- Skenario 3 -->
      <button type="button" onclick="fillPreset('scenario3')" class="text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-rose-500 transition group">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-bold text-rose-400 group-hover:text-rose-300">Skenario 3: Defisiensi Fosfat (P)</span>
          <span class="text-[10px] bg-slate-700 px-1.5 py-0.5 rounded text-slate-300">Tanah Masam</span>
        </div>
        <p class="text-[11px] text-slate-400 line-clamp-2">Daun pucat & kerdil, pH asam. NPK & SP-36 bersaing (pilihan setara).</p>
      </button>

      <!-- Skenario 4 -->
      <button type="button" onclick="fillPreset('scenario4')" class="text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-purple-500 transition group">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-bold text-purple-400 group-hover:text-purple-300">Skenario 4: Defisiensi Kalium (K)</span>
          <span class="text-[10px] bg-slate-700 px-1.5 py-0.5 rounded text-slate-300">Main Lanjut</span>
        </div>
        <p class="text-[11px] text-slate-400 line-clamp-2">Tepi daun menguning/bercak nekrosis. Menguji efektivitas pupuk KCl.</p>
      </button>

      <!-- Skenario 5 -->
      <button type="button" onclick="fillPreset('scenario5')" class="text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-red-500 transition group">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-bold text-red-400 group-hover:text-red-300">Skenario 5: Media Terlalu Basah</span>
          <span class="text-[10px] bg-red-900/60 px-1.5 py-0.5 rounded text-red-300 font-bold">Rule Tunda</span>
        </div>
        <p class="text-[11px] text-slate-400 line-clamp-2">Tanah jenuh air pasca hujan lebat. Menguji aturan TUNDA pemupukan.</p>
      </button>

      <!-- Skenario 6 -->
      <button type="button" onclick="fillPreset('scenario6')" class="text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-amber-500 transition group">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-bold text-amber-400 group-hover:text-amber-300">Skenario 6: Media Kering / Rendah</span>
          <span class="text-[10px] bg-amber-900/60 px-1.5 py-0.5 rounded text-amber-300 font-bold">Rule Siram</span>
        </div>
        <p class="text-[11px] text-slate-400 line-clamp-2">Media di bawah kapasitas lapang. Menguji aturan SIRAM DAHULU.</p>
      </button>

    </div>
  </div>

  <!-- MAIN INPUT FORM -->
  <form id="recommendation-form" action="/rekomendasi/hitung" method="POST" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Card 1: Identitas Batch & Bibit -->
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center space-x-2 text-slate-800 font-bold text-sm mb-4 pb-2 border-b border-slate-100">
        <div class="w-6 h-6 rounded bg-slate-100 text-slate-600 flex items-center justify-center text-xs">1</div>
        <span>Identitas Bibit & Polybag</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="batch_code" class="block text-xs font-semibold text-slate-700 mb-1">
            Kode Batch / Nomor Polybag <span class="text-red-500">*</span>
          </label>
          <input type="text" id="batch_code" name="batch_code" value="<%= typeof nextBatchCode !== 'undefined' ? nextBatchCode : 'BS-2026-001' %>" maxlength="40" required
            class="w-full text-sm px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-palm-500 focus:border-palm-500 transition font-mono">
          <p class="text-[11px] text-slate-400 mt-1">Identifikasi kelompok bibit di bedeng pembibitan (otomatis urut unik).</p>
        </div>

        <div>
          <label for="variety" class="block text-xs font-semibold text-slate-700 mb-1">
            Varietas Kelapa Sawit
          </label>
          <select id="variety" name="variety" class="w-full text-sm px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-palm-500 focus:border-palm-500 transition">
            <option value="DxP Socfindo">DxP Socfindo</option>
            <option value="DxP Marihat">DxP Marihat (PPKS)</option>
            <option value="DxP Dami Mas">DxP Dami Mas</option>
            <option value="DxP Topaz">DxP Topaz</option>
            <option value="DxP Yangambi">DxP Yangambi (PPKS)</option>
            <option value="DxP Sriwijaya">DxP Sriwijaya</option>
            <option value="DxP Lonsum">DxP Lonsum</option>
          </select>
          <p class="text-[11px] text-slate-400 mt-1">Varietas bibit bersertifikat unggul.</p>
        </div>
      </div>
    </div>

    <!-- Card 2: Kriteria C1 - Kondisi Daun -->
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
        <div class="flex items-center space-x-2 text-slate-800 font-bold text-sm">
          <div class="w-6 h-6 rounded bg-palm-100 text-palm-700 flex items-center justify-center text-xs">C1</div>
          <span>Kondisi Morfologi Daun</span>
        </div>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-palm-100 text-palm-800 border border-palm-200">
          Bobot: 0.35 (35%)
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        
        <!-- Pilihan 1: Menguning Merata -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Klorosis N</span>
              <input type="radio" name="leaf_condition" value="menguning_merata" required class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Menguning Merata</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Helaian daun tua menguning seragam hingga daun muda. Mengindikasikan defisiensi hara Nitrogen pekat.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-palm-700 font-medium">
            <i class="fas fa-arrow-circle-right mr-1"></i> Prioritas: Urea / NPK
          </div>
        </label>

        <!-- Pilihan 2: Menguning di tepi atau bercak -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-orange-800 bg-orange-50 px-2 py-0.5 rounded border border-orange-200">Nekrosis K</span>
              <input type="radio" name="leaf_condition" value="menguning_tepi" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Menguning di Tepi / Bercak</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Bercak kuning oranye dan tepi daun mengering (nekrosis). Mengindikasikan defisiensi hara Kalium.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-palm-700 font-medium">
            <i class="fas fa-arrow-circle-right mr-1"></i> Prioritas: KCl
          </div>
        </label>

        <!-- Pilihan 3: Pucat dan kerdil -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-rose-800 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">Kerdil P</span>
              <input type="radio" name="leaf_condition" value="pucat_kerdil" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Pucat dan Kerdil</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Pertumbuhan bibit terhambat, daun sempit kaku warna pucat kusam. Mengindikasikan defisiensi Fosfat.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-palm-700 font-medium">
            <i class="fas fa-arrow-circle-right mr-1"></i> Prioritas: SP-36 / NPK
          </div>
        </label>

        <!-- Pilihan 4: Normal -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Sehat</span>
              <input type="radio" name="leaf_condition" value="normal" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Normal (Sehat)</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Warna hijau segar mengkilap tanpa gejala klorosis/nekrosis. Kebutuhan nutrisi pemeliharaan rutin.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-palm-700 font-medium">
            <i class="fas fa-arrow-circle-right mr-1"></i> Prioritas: POC / NPK
          </div>
        </label>

      </div>
    </div>

    <!-- Card 3: Kriteria C2 - Fase Bibit -->
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
        <div class="flex items-center space-x-2 text-slate-800 font-bold text-sm">
          <div class="w-6 h-6 rounded bg-palm-100 text-palm-700 flex items-center justify-center text-xs">C2</div>
          <span>Fase Pertumbuhan Bibit</span>
        </div>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-palm-100 text-palm-800 border border-palm-200">
          Bobot: 0.25 (25%)
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        
        <!-- Pilihan 1: Pre-nursery -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-blue-800 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">Baby Polybag</span>
              <input type="radio" name="growth_phase" value="pre_nursery" required class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Pre-Nursery</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Umur 1 - 3 bulan. Sistem perakaran masih halus dan sensitif terhadap kepekatan garam pupuk kimia.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-slate-400">
            Dosis: Rendah / Larutan Encer
          </div>
        </label>

        <!-- Pilihan 2: Main nursery awal -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Large Polybag</span>
              <input type="radio" name="growth_phase" value="main_nursery_awal" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Main Nursery Awal</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Umur 4 - 7 bulan. Fase pertumbuhan vegetatif pesat pembentukan pelepah dan lingkar batang.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-slate-400">
            Dosis: Sedang (5-6 g NPK, Kasno & Anggria 2016)
          </div>
        </label>

        <!-- Pilihan 3: Main nursery lanjut -->
        <label class="option-card border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-indigo-800 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">Siap Salur Tanam</span>
              <input type="radio" name="growth_phase" value="main_nursery_lanjut" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </div>
            <h4 class="font-bold text-slate-800 text-sm">Main Nursery Lanjut</h4>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Umur 8 - 12 bulan. Penguatan batang kayu dan ketahanan kutikula pelepah untuk persiapan pindah tanam ke kebun.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-slate-400">
            Dosis: Standar Lanjut / Tinggi
          </div>
        </label>

      </div>
    </div>

    <!-- Card 4: Kriteria C3 & C4 (pH Media & Kelembapan Media) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- C3: pH Media -->
      <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
            <div class="flex items-center space-x-2 text-slate-800 font-bold text-sm">
              <div class="w-6 h-6 rounded bg-palm-100 text-palm-700 flex items-center justify-center text-xs">C3</div>
              <span>Tingkat Keasaman (pH Media)</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-palm-100 text-palm-800 border border-palm-200">
              Bobot: 0.20 (20%)
            </span>
          </div>

          <div class="space-y-2.5">
            <label class="option-card border border-slate-200 rounded-xl p-3 flex items-center justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-800 text-sm">Asam</span>
                  <span class="text-xs font-mono bg-red-50 text-red-700 px-1.5 py-0.5 rounded border border-red-200">pH &lt; 5.0</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Tanah masam / gambut. Risiko fiksasi fosfat oleh Al dan Fe.</p>
              </div>
              <input type="radio" name="media_ph" value="asam" required class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </label>

            <label class="option-card border border-slate-200 rounded-xl p-3 flex items-center justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-800 text-sm">Optimal</span>
                  <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded border border-emerald-200">pH 5.5 - 6.5</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Rentang ideal bibit kelapa sawit untuk seluruh unsur N, P, K.</p>
              </div>
              <input type="radio" name="media_ph" value="optimal" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </label>

            <label class="option-card border border-slate-200 rounded-xl p-3 flex items-center justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-800 text-sm">Basa</span>
                  <span class="text-xs font-mono bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded border border-blue-200">pH &gt; 6.5</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Tanah berkapur tinggi. Ketersediaan hara mikro dapat terhambat.</p>
              </div>
              <input type="radio" name="media_ph" value="basa" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </label>
          </div>
        </div>
      </div>

      <!-- C4: Kelembapan Media -->
      <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
            <div class="flex items-center space-x-2 text-slate-800 font-bold text-sm">
              <div class="w-6 h-6 rounded bg-palm-100 text-palm-700 flex items-center justify-center text-xs">C4</div>
              <span>Kelembapan Media Tanam</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-palm-100 text-palm-800 border border-palm-200">
              Bobot: 0.20 (20%)
            </span>
          </div>

          <div class="space-y-2.5">
            <label class="option-card border border-slate-200 rounded-xl p-3 flex items-center justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-800 text-sm">Rendah (Kering)</span>
                  <span class="text-xs font-semibold bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded border border-amber-200">Perlu Air</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Di bawah kapasitas lapang. Membutuhkan penyiraman sebelum pupuk.</p>
              </div>
              <input type="radio" name="media_moisture" value="rendah" required class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </label>

            <label class="option-card border border-slate-200 rounded-xl p-3 flex items-center justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-800 text-sm">Optimal</span>
                  <span class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded border border-emerald-200">Kapasitas Lapang</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Kondisi ideal tanah remah lembap untuk kelarutan & serapan pupuk.</p>
              </div>
              <input type="radio" name="media_moisture" value="optimal" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
            </label>

            <label class="option-card border border-slate-200 rounded-xl p-3 flex items-center justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-800 text-sm">Terlalu Basah</span>
                  <span class="text-xs font-semibold bg-red-50 text-red-700 px-1.5 py-0.5 rounded border border-red-200">Jenuh Air / Hujan</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Tanah becek/menggenang. Berisiko tinggi pencucian hara (leaching).</p>
              </div>
              <input type="radio" name="media_moisture" value="terlalu_basah" class="text-palm-600 focus:ring-palm-500 h-4 w-4">
