<%- include('../layouts/header') %>

<div class="min-h-[60vh] flex items-center justify-center py-10 px-4">
  <div class="max-w-md w-full bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
    
    <div class="text-center mb-6">
      <div class="w-14 h-14 rounded-2xl bg-palm-100 border border-palm-300 text-palm-700 flex items-center justify-center text-2xl mx-auto mb-3 shadow-inner">
        <i class="fas fa-lock"></i>
      </div>
      <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Login Petugas Nursery</h2>
      <p class="text-xs text-slate-500 mt-1">
        Masuk untuk mengelola bobot kriteria, tabel kecocokan, dan arsip riwayat rekomendasi.
      </p>
    </div>

    <!-- Demo Credential Callout Banner -->
    <div class="mb-6 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs">
      <div class="flex items-start">
        <i class="fas fa-key text-amber-600 mt-0.5 mr-2.5 text-sm"></i>
        <div>
          <span class="font-bold">Akun Uji Coba Demo (Sidang / Dosen):</span>
          <div class="mt-1 font-mono text-[11px] space-y-0.5">
            <div>Username: <strong class="text-amber-950 font-bold">admin</strong></div>
            <div>Password: <strong class="text-amber-950 font-bold">admin123</strong></div>
          </div>
        </div>
      </div>
    </div>

    <form action="/login" method="POST" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="username" class="block text-xs font-semibold text-slate-700 mb-1">
          Username
        </label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
            <i class="fas fa-user text-xs"></i>
          </span>
          <input type="text" id="username" name="username" value="admin" required
            class="w-full text-sm pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-palm-500 focus:border-palm-500 transition font-medium">
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold text-slate-700 mb-1">
          Password
        </label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
            <i class="fas fa-lock text-xs"></i>
          </span>
          <input type="password" id="password" name="password" value="admin123" required
            class="w-full text-sm pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-palm-500 focus:border-palm-500 transition font-medium">
        </div>
      </div>

      <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-palm-600 hover:bg-palm-700 text-white font-bold text-sm shadow-md transition transform hover:-translate-y-0.5 mt-2">
        <i class="fas fa-sign-in-alt mr-1.5"></i> Masuk ke Sistem
      </button>

      <div class="text-center pt-3 border-t border-slate-100">
        <a href="/" class="text-xs font-semibold text-slate-500 hover:text-palm-700">
          <i class="fas fa-arrow-left mr-1"></i> Kembali ke Dashboard
        </a>
      </div>
    </form>

  </div>
</div>

<%- include('../layouts/footer') %>
