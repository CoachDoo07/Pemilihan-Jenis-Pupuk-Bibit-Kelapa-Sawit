<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'SPK Pemilihan Pupuk Sawit (SAW)' %></title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            palm: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#86efac',
              400: '#4ade80',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
              950: '#052e16',
            }
          }
        }
      }
    }
  </script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- CSRF Meta Token -->
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/custom.css">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
      .print-shadow-none {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- Navigation Bar -->
  <header class="bg-gradient-to-r from-palm-900 via-palm-800 to-palm-900 text-white shadow-lg sticky top-0 z-50 no-print border-b border-palm-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo & Title -->
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-palm-600/80 border border-palm-400 flex items-center justify-center text-white shadow-md group-hover:scale-105 transition-transform duration-200">
            <i class="fas fa-seedling text-xl text-palm-200"></i>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="font-bold text-lg tracking-tight text-white group-hover:text-palm-200 transition">SPK Pupuk Sawit</span>
              <span class="px-2 py-0.5 text-xs font-semibold bg-palm-700 text-palm-200 rounded-full border border-palm-500/40">Metode SAW</span>
            </div>
            <p class="text-[11px] text-palm-300">Pembibitan (Nursery) Kelapa Sawit</p>
          </div>
        </a>

        <!-- Desktop Menu -->
        <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
          <a href="/" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath === '/' ? 'bg-palm-700 text-white shadow-inner' : 'text-palm-200 hover:bg-palm-800/80 hover:text-white' %>">
            <i class="fas fa-chart-pie mr-1.5 opacity-80"></i> Dashboard
          </a>

          <a href="/rekomendasi/baru" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath.startsWith('/rekomendasi') ? 'bg-palm-700 text-white shadow-inner' : 'text-palm-200 hover:bg-palm-800/80 hover:text-white' %>">
            <i class="fas fa-calculator mr-1.5 opacity-80"></i> Analisis Rekomendasi
          </a>

          <a href="/riwayat" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath.startsWith('/riwayat') ? 'bg-palm-700 text-white shadow-inner' : 'text-palm-200 hover:bg-palm-800/80 hover:text-white' %>">
            <i class="fas fa-history mr-1.5 opacity-80"></i> Riwayat
          </a>

          <a href="/pengaturan" class="px-3 py-2 rounded-lg text-sm font-medium transition <%= currentPath.startsWith('/pengaturan') ? 'bg-palm-700 text-white shadow-inner' : 'text-palm-200 hover:bg-palm-800/80 hover:text-white' %>">
            <i class="fas fa-sliders-h mr-1.5 opacity-80"></i> Pengaturan Bobot & Matriks
          </a>
        </nav>

        <!-- Right Side: User & Demo Badge -->
        <div class="hidden sm:flex items-center space-x-3">
          <% if (user) { %>
            <div class="flex items-center space-x-2 bg-palm-800/90 py-1.5 px-3 rounded-lg border border-palm-600/50">
              <i class="fas fa-user-shield text-palm-300 text-sm"></i>
              <span class="text-xs font-semibold text-white"><%= user.name %></span>
              <a href="/logout" class="ml-2 text-xs text-red-300 hover:text-red-100 hover:underline" title="Keluar">
                <i class="fas fa-sign-out-alt"></i>
              </a>
            </div>
          <% } else { %>
            <a href="/login" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-palm-800/80 hover:bg-palm-700 text-palm-200 border border-palm-600/60 transition">
              <i class="fas fa-lock mr-1.5 text-palm-300"></i> Login Admin
            </a>
          <% } %>
        </div>

        <!-- Mobile Menu Button -->
        <div class="md:hidden flex items-center">
          <button id="mobile-menu-btn" type="button" class="text-palm-200 hover:text-white p-2 rounded-lg focus:outline-none" aria-label="Toggle menu">
            <i class="fas fa-bars text-xl"></i>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Menu dropdown -->
    <div id="mobile-menu" class="hidden md:hidden bg-palm-950 px-4 pt-2 pb-4 space-y-1 border-t border-palm-800">
      <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-white hover:bg-palm-800">Dashboard</a>
      <a href="/rekomendasi/baru" class="block px-3 py-2 rounded-md text-base font-medium text-white hover:bg-palm-800">Analisis Rekomendasi</a>
      <a href="/riwayat" class="block px-3 py-2 rounded-md text-base font-medium text-white hover:bg-palm-800">Riwayat</a>
      <a href="/pengaturan" class="block px-3 py-2 rounded-md text-base font-medium text-white hover:bg-palm-800">Pengaturan Bobot & Matriks</a>
      <div class="pt-2 border-t border-palm-800 flex justify-between items-center">
        <% if (user) { %>
          <span class="text-xs text-palm-300"><i class="fas fa-user-shield mr-1"></i><%= user.name %></span>
          <a href="/logout" class="text-xs text-red-300">Logout</a>
        <% } else { %>
          <a href="/login" class="text-xs text-palm-300 hover:text-white"><i class="fas fa-lock mr-1"></i>Login Admin</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Flash Messages & Content Container -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <%- include('./alerts') %>
